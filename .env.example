# ==========================================
# KOBO LAUNCHPAD CONFIGURATION (.env)
# ==========================================

# ------------------------------------------
# 1. DYNAMIC (Wallet & Authentication)
# Get from: https://app.dynamic.xyz -> Project Settings -> API Keys
# ------------------------------------------
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# ------------------------------------------
# 2. PAYSTACK (Naira Payment Gateway - Test Mode)
# Get from: https://dashboard.paystack.com/#/settings/developer
# ------------------------------------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_
PAYSTACK_SECRET_KEY=sk_test_

# ------------------------------------------
# 3. BASE SEPOLIA (Blockchain & Contracts)
# ------------------------------------------
# Base Sepolia RPC URL (Default public RPC works, or use Alchemy/Infura)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Testnet Deployer & Relayer Wallet Private Key (Ensure it has some Base Sepolia ETH for gas)
# Faucet for Base Sepolia ETH: https://www.alchemy.com/faucets/base-sepolia or https://faucets.chain.link
DEPLOYER_PRIVATE_KEY=

# ------------------------------------------
# 4. EXPLORER & VERIFICATION (Optional)
# Get from: https://basescan.org/myapikey
# ------------------------------------------
BASESCAN_API_KEY=

# ------------------------------------------
# 5. IPFS / METADATA STORAGE (Optional)
# Get from: https://app.pinata.cloud/developers/api-keys
# ------------------------------------------
PINATA_JWT=
NEXT_PUBLIC_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# ------------------------------------------
# 6. FIREBASE (Cloud Serverless Persistence)
# Get from: https://console.firebase.google.com -> Project Settings
# ------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
