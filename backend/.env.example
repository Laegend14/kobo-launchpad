# Express Backend Port
PORT=4000

# ── Arc Testnet RPC (the ONLY required config) ──────────────────────────────
# The chain is the single source of truth. The backend runs a continuous indexer
# that reads token & trade state directly from Arc — no database required.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# Optional comma-separated fallbacks used on rate-limit / RPC failure:
# ARC_RPC_FALLBACKS=https://arc-testnet.blockdaemon.tech,https://arc-testnet.drpc.org

# TokenFactory address on Arc testnet (the on-chain registry the indexer enumerates).
TOKEN_FACTORY_ADDRESS=0x4Ca9A69ff8dBF37819d21DB37260142416796D72

# ── Fiat ramp (simulated) — optional on-chain cNGN mint ─────────────────────
# If set, deposit confirmation performs a real MockCNGN faucetMint; otherwise the
# ramp simulates balances in-memory. All real value lives on-chain regardless.
# MOCKCNGN_OWNER_PRIVATE_KEY=
# MOCKCNGN_ADDRESS=
# BASE_SEPOLIA_RPC_URL=
