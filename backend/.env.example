# Express Backend Port
PORT=4000

# Arc Testnet RPC URL
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# ── Durable store (REQUIRED) ────────────────────────────────────────────────
# The backend refuses to start without a durable, cross-instance store. The Arc
# chain is the source of truth for tokens & trades; this store mirrors off-chain
# metadata (description + image) and backs the fiat ramp. Provide EITHER a direct
# Postgres URL OR Supabase credentials.
#
# Option A — direct Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/kobo_db
#
# Option B — Supabase REST:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# For privileged writes/reset, prefer a service key:
# SUPABASE_SECRET_KEY=sb_secret_xxx
